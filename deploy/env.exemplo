# Configuração do servidor (copiada para /opt/ponto/.env pelo instalar.sh). NÃO envie este arquivo preenchido ao
# GitHub: ele guarda a senha do banco.

# imagem montada pelo GitHub (Actions → "Imagem de produção") e a versão em uso (o atualizador troca esta linha)
IMAGEM=ghcr.io/admsmartfit/rh
VERSAO=v2026.11.13
REPOSITORIO=Admsmartfit/RH

# nome do site (o endereço público) e a porta local que o túnel do Cloudflare usa
SITE=ponto.ricardo.home.nom.br
PORTA=5020

# senha do root do MariaDB (o instalar.sh sorteia uma; guarde)
SENHA_BANCO=troque-esta-senha
